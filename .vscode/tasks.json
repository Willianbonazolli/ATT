{
    "tasks": [
        {
            "label": "Preparar pastas de compilação C",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "New-Item -ItemType Directory -Force -Path '${workspaceFolder}\\C\\atividades_c\\build\\bin', '${workspaceFolder}\\C\\atividades_c\\build\\obj', '${workspaceFolder}\\C\\atividades_c\\build\\debug' | Out-Null"
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C: compilar arquivo ativo em atividades_c/build",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/nologo",
                "/Fo${workspaceFolder}\\C\\atividades_c\\build\\obj\\${fileBasenameNoExtension}.obj",
                "/Fd${workspaceFolder}\\C\\atividades_c\\build\\debug\\${fileBasenameNoExtension}.compile.pdb",
                "/Fe${workspaceFolder}\\C\\atividades_c\\build\\bin\\${fileBasenameNoExtension}.exe",
                "${file}",
                "/link",
                "/PDB:${workspaceFolder}\\C\\atividades_c\\build\\debug\\${fileBasenameNoExtension}.pdb",
                "/ILK:${workspaceFolder}\\C\\atividades_c\\build\\debug\\${fileBasenameNoExtension}.ilk"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\C\\atividades_c\\build"
            },
            "dependsOn": "Preparar pastas de compilação C",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
